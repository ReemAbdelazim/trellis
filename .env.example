# Copy to .env.local for local development (or run: node scripts/ci-env.mjs).
# Both values are public: the publishable key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sub-path the site is served from, e.g. /seeds-tasks on GitHub Pages. Empty for local/custom domain.
NEXT_PUBLIC_BASE_PATH=

# Local test scripts only (never needed by the website)
SUPABASE_SECRET_KEY=
